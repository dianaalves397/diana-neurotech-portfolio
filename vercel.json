{
  "cleanUrls": true,
  "trailingSlash": false,
  "alias": [
    "diana-biomedical-technology-portfolio.vercel.app"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
