@@ -0,0 +1,28 @@
+import numpy as np
+import numpy.testing as npt
+
+from emg2mu.detection.duplicate_detection import remove_duplicates
+
+
+def test_remove_duplicates_handles_consecutive_close_spikes():
+    """Close-spike cleanup should use real sample indices and re-check after removal."""
+    spike_train = np.zeros((1000, 1), dtype=int)
+    spike_train[[100, 110, 120, 500, 800], 0] = 1
+
+    source = np.zeros((1000, 1), dtype=float)
+    source[100, 0] = 0.4
+    source[110, 0] = 0.9
+    source[120, 0] = 0.2
+    source[500, 0] = 0.8
+    source[800, 0] = 0.7
+
+    cleaned, _, good_idx = remove_duplicates(
+        spike_train,
+        source,
+        sampling_frequency=1000,
+        min_firing_rate=1,
+        max_firing_rate=35,
+    )
+
+    npt.assert_array_equal(np.flatnonzero(cleaned[:, 0]), [110, 500, 800])
+    npt.assert_array_equal(good_idx, [0])
